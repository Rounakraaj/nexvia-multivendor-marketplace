generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  VENDOR
  ADMIN
}

enum OrderStatus {
  PENDING
  PAID
  PACKED
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentProvider {
  SIMULATED
  RAZORPAY
}

enum PaymentStatus {
  PENDING
  CAPTURED
  FAILED
  REFUND_PENDING
  REFUNDED
  CANCELLED
}

enum CouponFunding {
  PLATFORM
  VENDOR
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(CUSTOMER)
  createdAt DateTime @default(now())

  vendor Vendor?
  orders Order[]
  orderStatusChanges OrderStatusHistory[]
}

model Vendor {
  id        String   @id @default(cuid())
  userId    String   @unique
  shopName  String
  approved  Boolean  @default(false)
  balance   Decimal  @default(0) @db.Decimal(10, 2)
  createdAt DateTime @default(now())

  user       User        @relation(fields: [userId], references: [id])
  products   Product[]
  orderItems OrderItem[]
}

model Product {
  id            String   @id @default(cuid())
  sourceKey     String?  @unique
  vendorId      String
  title         String
  description   String?
  price         Decimal  @db.Decimal(10, 2)
  stock         Int      @default(0)
  image         String?
  category      String
  averageRating Float    @default(0)
  ratingCount   Int      @default(0)
  createdAt     DateTime @default(now())

  vendor     Vendor      @relation(fields: [vendorId], references: [id])
  orderItems OrderItem[]
}

model Order {
  id              String      @id @default(cuid())
  customerId      String
  total           Decimal     @db.Decimal(10, 2)
  subtotal        Decimal     @default(0) @db.Decimal(10, 2)
  discountTotal   Decimal     @default(0) @db.Decimal(10, 2)
  couponCode      String?
  couponFunding   CouponFunding?
  couponReservationKey String?
  status          OrderStatus @default(PENDING)
  shippingName    String?
  shippingPhone   String?
  shippingAddress String?
  idempotencyKey  String?
  createdAt       DateTime    @default(now())

  customer User        @relation(fields: [customerId], references: [id])
  items    OrderItem[]
  statusHistory OrderStatusHistory[]
  payment Payment?

  @@unique([customerId, idempotencyKey])
  @@index([customerId, createdAt])
}

model Payment {
  id               String          @id @default(cuid())
  orderId          String          @unique
  provider         PaymentProvider
  status           PaymentStatus   @default(PENDING)
  amount           Decimal         @db.Decimal(10, 2)
  currency         String          @default("INR")
  gatewayOrderId   String?         @unique
  gatewayPaymentId String?         @unique
  gatewayRefundId  String?         @unique
  failureReason    String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([provider, status, createdAt])
}

model OrderStatusHistory {
  id          String      @id @default(cuid())
  orderId     String
  status      OrderStatus
  note        String?
  changedById String?
  createdAt   DateTime    @default(now())

  order     Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  changedBy User? @relation(fields: [changedById], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
}

model OrderItem {
  id            String  @id @default(cuid())
  orderId       String
  productId     String
  vendorId      String
  price         Decimal @db.Decimal(10, 2)
  qty           Int
  commission    Decimal @db.Decimal(10, 2)
  vendorEarning Decimal @db.Decimal(10, 2)
  discount      Decimal @default(0) @db.Decimal(10, 2)
  vendorDiscount Decimal @default(0) @db.Decimal(10, 2)

  order   Order   @relation(fields: [orderId], references: [id])
  product Product @relation(fields: [productId], references: [id])
  vendor  Vendor  @relation(fields: [vendorId], references: [id])

  @@index([vendorId, orderId])
}

model Setting {
  id             Int   @id @default(1)
  commissionRate Float @default(10)
}
