DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=verify-full"
NEXTAUTH_SECRET="generate-with-node-crypto-randomBytes"
NEXTAUTH_URL="http://localhost:3000"

# Payment is simulated unless Razorpay test mode is selected.
PAYMENT_PROVIDER="simulated"
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
PAYMENT_PENDING_TTL_MINUTES="30"
CRON_SECRET=""
DUMMYJSON_USD_TO_INR="83.5"
SEED_PRODUCT_LIMIT="60"
CSV_SOURCE_TO_INR_RATE="1"
CSV_IMPORT_DEFAULT_STOCK="10"

# Optional S3-compatible product image storage. Leave these blank to disable uploads.
S3_ENDPOINT=""
S3_REGION="us-east-1"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE="false"

# Optional local services are started with docker compose up -d.
ELASTICSEARCH_URL="http://localhost:9200"
ELASTICSEARCH_INDEX="nexvia-products"
ELASTICSEARCH_API_KEY=""
ELASTICSEARCH_USERNAME=""
ELASTICSEARCH_PASSWORD=""
MONGODB_URI="mongodb://nexvia:local-dev-only-change-me@localhost:27017/?authSource=admin"
MONGODB_DATABASE="nexvia"
MONGO_ROOT_USERNAME="nexvia"
MONGO_ROOT_PASSWORD="local-dev-only-change-me"
REDIS_URL="redis://localhost:6379"
API_SERVICE_URL="http://127.0.0.1:4100"
API_SERVICE_HOST="127.0.0.1"
API_SERVICE_PORT="4100"
SERVICE_API_SECRET="replace-with-a-long-random-secret"
